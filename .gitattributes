* text=auto

# Sources and text: LF in the repository and the working tree.
*.c   text eol=lf
*.h   text eol=lf
*.cpp text eol=lf
*.sh  text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.adoc text eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries.
*.png binary
*.pdf binary
*.gz  binary
